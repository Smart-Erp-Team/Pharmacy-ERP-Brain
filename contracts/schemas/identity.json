{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmacy-erp.local/contracts/schemas/identity.json",
  "title": "Pharmacy ERP \u2014 Identity & Branch Enrollment Contract (Stage 1)",
  "description": "Organization provisioning, branches, enrollment tokens, employees, and hierarchical user management matching apps/erp-backend/contracts/openapi.v1.json 100% verbatim.",
  "$defs": {
    "OrganizationDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "organization_code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "base_currency": {
          "type": "string"
        },
        "time_zone_id": {
          "type": "string"
        },
        "initial_branch_id": {
          "type": "string",
          "format": "uuid"
        },
        "initial_employee_id": {
          "type": "string",
          "format": "uuid"
        },
        "initial_admin_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "enrollment_setup_state": {
          "type": "string"
        }
      }
    },
    "CreateOrganizationRequest": {
      "type": "object",
      "required": [
        "address",
        "initial_admin",
        "initial_branch",
        "initial_employee",
        "name",
        "organization_code",
        "time_zone_id"
      ],
      "additionalProperties": false,
      "properties": {
        "organization_code": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "base_currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "time_zone_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "address": {
          "$ref": "common.json#/$defs/AddressDto"
        },
        "initial_branch": {
          "$ref": "#/$defs/CreateBranchRequest"
        },
        "initial_employee": {
          "$ref": "#/$defs/CreateEmployeeRequest"
        },
        "initial_admin": {
          "$ref": "#/$defs/CreateUserRequest"
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "BranchDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "type": "string",
          "format": "uuid"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "branch_code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "$ref": "common.json#/$defs/AddressDto"
        },
        "is_active": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "BranchDtoPagedResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BranchDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "total_count": {
          "type": "integer",
          "format": "int32"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CreateBranchRequest": {
      "type": "object",
      "required": [
        "address",
        "branch_code",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "branch_code": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "address": {
          "$ref": "common.json#/$defs/AddressDto"
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "UpdateBranchRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 150
        },
        "address": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/AddressDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "EnrollmentTokenResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "RedeemBranchEnrollmentRequest": {
      "type": "object",
      "required": [
        "token"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RedeemBranchEnrollmentResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "branch_id": {
          "type": "string",
          "format": "uuid"
        },
        "runtime_credential": {
          "type": "string"
        },
        "initial_sync_cursor": {
          "type": "integer",
          "format": "int64"
        },
        "credential_expiry": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EmployeeDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "employee_id": {
          "type": "string",
          "format": "uuid"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "branch_id": {
          "type": "string",
          "format": "uuid"
        },
        "employee_no": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_title": {
          "type": "string"
        },
        "address": {
          "$ref": "common.json#/$defs/AddressDto"
        },
        "hired_on": {
          "type": "string",
          "format": "date"
        },
        "is_active": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EmployeeDtoPagedResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EmployeeDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "total_count": {
          "type": "integer",
          "format": "int32"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CreateEmployeeRequest": {
      "type": "object",
      "required": [
        "address",
        "employee_no",
        "full_name",
        "job_title"
      ],
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "type": "string",
          "format": "uuid"
        },
        "employee_no": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "full_name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email",
          "minLength": 0,
          "maxLength": 254
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 30
        },
        "job_title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "address": {
          "$ref": "common.json#/$defs/AddressDto"
        },
        "hired_on": {
          "type": "string",
          "format": "date"
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "UpdateEmployeeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 150
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email",
          "minLength": 0,
          "maxLength": 254
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 30
        },
        "job_title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 80
        },
        "address": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/AddressDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "UserDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "employee_id": {
          "type": "string",
          "format": "uuid"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string"
        },
        "role": {
          "$ref": "common.json#/$defs/UserRole"
        },
        "branch_scope": {
          "$ref": "common.json#/$defs/BranchScope"
        },
        "is_active": {
          "type": "boolean"
        },
        "branch_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "last_login_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lockout_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "access_failed_count": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "UserDtoPagedResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "total_count": {
          "type": "integer",
          "format": "int32"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CreateUserRequest": {
      "type": "object",
      "required": [
        "password",
        "username"
      ],
      "additionalProperties": false,
      "properties": {
        "employee_id": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "password": {
          "type": "string",
          "minLength": 12
        },
        "role": {
          "$ref": "common.json#/$defs/UserRole"
        },
        "branch_scope": {
          "$ref": "common.json#/$defs/BranchScope"
        },
        "branch_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "UpdateUserRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/UserRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch_scope": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/BranchScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "is_active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ResetPasswordRequest": {
      "type": "object",
      "required": [
        "new_password"
      ],
      "additionalProperties": false,
      "properties": {
        "new_password": {
          "type": "string",
          "minLength": 12
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
