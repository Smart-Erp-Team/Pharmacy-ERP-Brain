{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmacy-erp.local/contracts/schemas/sales.json",
  "title": "Pharmacy ERP — Sales Orders, Checkout, Invoices, Payments, Returns & Refunds Contract (Stage 2)",
  "description": "Stage 2 POS sales order drafts, atomic checkout, immutable sales invoices, full cash payments, sales returns (RESTOCK/QUARANTINE/SCRAP), and cash refunds derived verbatim from yassin.md (YA-02), el-hosseiny.md (EH-02), and ahmed-salah.md (AS-02). Strict snake_case, native JSON numbers, and string-only enums.",
  "$defs": {
    "OrderChannel": {
      "type": "string",
      "enum": [
        "POS"
      ]
    },
    "SalesOrderStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "SalesInvoiceStatus": {
      "type": "string",
      "enum": [
        "ISSUED"
      ]
    },
    "SalesPaymentStatus": {
      "type": "string",
      "enum": [
        "PAID",
        "PARTIALLY_REFUNDED",
        "REFUNDED"
      ]
    },
    "PaymentMethod": {
      "type": "string",
      "enum": [
        "CASH"
      ]
    },
    "SalesReturnStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "POSTED",
        "CANCELLED"
      ]
    },
    "SalesRefundStatus": {
      "type": "string",
      "enum": [
        "NOT_REFUNDED",
        "PARTIALLY_REFUNDED",
        "REFUNDED"
      ]
    },
    "ReturnDisposition": {
      "type": "string",
      "enum": [
        "RESTOCK",
        "QUARANTINE",
        "SCRAP"
      ]
    },
    "SalesOrderLineRequest": {
      "type": "object",
      "required": [
        "product_id",
        "product_uom_id",
        "entered_qty"
      ],
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "type": "string",
          "format": "uuid"
        },
        "product_uom_id": {
          "type": "string",
          "format": "uuid"
        },
        "entered_qty": {
          "type": "number",
          "format": "double",
          "exclusiveMinimum": 0
        }
      }
    },
    "CreateSalesOrderRequest": {
      "type": "object",
      "required": [
        "branch_id",
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "type": "string",
          "format": "uuid"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/SalesOrderLineRequest"
          }
        },
        "idempotency_key": {
          "$ref": "common.json#/$defs/IdempotencyKey"
        }
      }
    },
    "ReplaceSalesOrderLinesRequest": {
      "type": "object",
      "required": [
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
