{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmacy-erp.local/contracts/schemas/common.json",
  "title": "Pharmacy ERP \u2014 Shared Contract Primitives (Stage 1)",
  "description": "Shared primitives, enums, error envelope, and pagination envelope matching apps/erp-backend/contracts/openapi.v1.json 100% verbatim. Strict snake_case and native JSON numbers everywhere.",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "description": "RFC 4122 UUID / .NET Guid."
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp with offset (DateTimeOffset)."
    },
    "DateOnly": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 calendar date (YYYY-MM-DD)."
    },
    "IdempotencyKey": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "description": "Optional in JSON body when provided via the Idempotency-Key HTTP header (max 100 characters)."
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "MALFORMED_REQUEST",
        "UNAUTHORIZED",
        "FORBIDDEN",
        "FORBIDDEN_BRANCH",
        "NOT_FOUND",
        "CONFLICT",
        "INVALID_STATE_TRANSITION",
        "OUT_OF_STOCK",
        "IDEMPOTENCY_MISMATCH",
        "VALIDATION_ERROR",
        "EXPIRY_POLICY_VIOLATION",
        "INTERNAL_SERVER_ERROR"
      ],
      "description": "Exact Stage 1 ErrorCode enum values plus INTERNAL_SERVER_ERROR for HTTP 500."
    },
    "PermissionScope": {
      "type": "string",
      "enum": [
        "user:admin",
        "inventory:read",
        "inventory:write",
        "sales:read",
        "sales:write"
      ],
      "description": "Exact Stage 1 emitted JWT scopes vocabulary (Admin: all 5; Pharmacist: inventory:read, inventory:write, sales:read; Cashier: inventory:read, sales:read, sales:write)."
    },
    "PagedResult": {
      "type": "object",
      "required": [
        "items",
        "page",
        "page_size",
        "total_count",
        "next_cursor"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array"
        },
        "page": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 200
        },
        "total_count": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Standard Stage 1 pagination envelope for ERP list endpoints (page default 1, page_size default 25, max 200)."
    },
    "AddressDto": {
      "type": "object",
      "required": [
        "city",
        "country_code",
        "line1"
      ],
      "additionalProperties": false,
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "line2": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 100
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 0,
          "maxLength": 20
        },
        "country_code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      }
    },
    "ApiErrorDetailDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        }
      }
    },
    "ApiErrorBodyDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApiErrorDetailDto"
          }
        },
        "trace_id": {
          "type": "string"
        }
      }
    },
    "ApiErrorEnvelopeDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiErrorBodyDto"
        }
      }
    },
    "UserRole": {
      "type": "string",
      "enum": [
        "Admin",
        "Pharmacist",
        "Cashier"
      ]
    },
    "BranchScope": {
      "type": "string",
      "enum": [
        "ALL",
        "ASSIGNED"
      ]
    },
    "ErpRuntimeMode": {
      "type": "string",
      "enum": [
        "Cloud",
        "BranchLocal"
      ]
    }
  }
}
