{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmacy-erp.local/contracts/schemas/inventory.json",
  "title": "Pharmacy ERP \u2014 Inventory Locations, Batches, Balances & Ledger Contract (Stage 1)",
  "description": "Inventory locations (including DAMAGED), batches, paginated stock balances with row_version, product summary, immutable ledger transactions, and BranchLocal stock adjustments/reversals matching apps/erp-backend/contracts/openapi.v1.json 100% verbatim.",
  "$defs": {
    "LocationType": {
      "type": "string",
      "enum": [
        "SELLABLE",
        "QUARANTINE",
        "DAMAGED",
        "SCRAP"
      ]
    },
    "BatchQualityStatus": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "QUARANTINED",
        "EXPIRED",
        "RECALLED"
      ]
    },
    "InventoryTransactionType": {
      "type": "string",
      "enum": [
        "OPENING_BALANCE",
        "ADJUSTMENT_IN",
        "ADJUSTMENT_OUT",
        "SALE_ISSUE",
        "SALES_RETURN_IN",
        "PURCHASE_RECEIPT",
        "VENDOR_RETURN_OUT",
        "SCRAP_OUT",
        "REVERSAL"
      ]
    },
    "InventoryTransactionStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "POSTED",
        "CANCELLED"
      ]
    },
    "InventoryLocationDto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "type": "string",
          "format": "uuid"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "branch_id": {
          "type": "string",
          "format": "uuid"
        },
        "location_code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "location_type": {
          "$ref": "#/$defs/LocationType"
        },
        "is_sellable": {
          "type": "boolean"
        },
        "is_active": {
          "type": "boolean"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "InventoryLocationDtoPagedResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryLocationDto"
          }
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "page_size": {
          "type": "integer",
          "format": "int32"
        },
        "total_count": {
          "type": "integer",
          "format": "int32"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
