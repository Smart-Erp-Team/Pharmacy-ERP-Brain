    "CompleteSalesOrderSyncPayloadV1": {
      "type": "object",
      "description": "Immutable v1 branch-to-cloud sync payload for COMPLETE_SALES_ORDER carrying exact posted order, invoice, payment, SALE_ISSUE inventory ledger, and audit facts without recalculating FEFO (AH-07, AH-09).",
      "required": [
        "sales_order",
        "sales_invoice",
        "sales_payment",
        "sale_issue_txn",
        "audit"
      ],
      "additionalProperties": false,
      "properties": {
        "sales_order": {
          "$ref": "#/$defs/SyncSalesOrderFactV1"
        },
        "sales_invoice": {
          "$ref": "#/$defs/SyncSalesInvoiceFactV1"
        },
        "sales_payment": {
          "$ref": "#/$defs/SyncSalesPaymentFactV1"
        },
        "sale_issue_txn": {
          "$ref": "#/$defs/SyncInventoryTxnFactV1"
        },
        "audit": {
          "$ref": "#/$defs/SyncAuditFactDto"
        }
      }
    },
    "PostSalesReturnSyncPayloadV1": {
      "type": "object",
      "description": "Immutable v1 branch-to-cloud sync payload for POST_SALES_RETURN carrying exact posted return, optional cash refund, SALES_RETURN_IN and optional SCRAP_OUT inventory ledgers, and audit facts (AH-07, AH-09).",
      "required": [
        "sales_return",
        "return_stock_txn",
        "audit"
      ],
      "additionalProperties": false,
      "properties": {
        "sales_return": {
          "$ref": "#/$defs/SyncSalesReturnFactV1"
        },
        "sales_refund": {
          "oneOf": [
            {
              "$ref": "#/$defs/SyncSalesRefundFactV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "return_stock_txn": {
          "$ref": "#/$defs/SyncInventoryTxnFactV1"
        },
        "scrap_out_txn": {
          "oneOf": [
            {
              "$ref": "#/$defs/SyncInventoryTxnFactV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "audit": {
          "$ref": "#/$defs/SyncAuditFactDto"
        }
      }
    },
