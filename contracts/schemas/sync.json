{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmacy-erp.local/contracts/schemas/sync.json",
  "title": "Pharmacy ERP — Offline Sync Engine Contract (Stage 2)",
  "description": "Stage 2 BranchLocal-to-Cloud push ingestion, authorized conflict retry, Cloud-to-Branch bootstrap/changes pull feeds, sync enums, and versioned v1 immutable fact payloads derived verbatim from ahmed-hassan.md (AH-01, AH-07..AH-12). Strict snake_case, native JSON numbers, and string-only enums.",
  "$defs": {
    "SyncOperationType": {
      "type": "string",
      "description": "Closed Blueprint §8.9.11 DB CHECK vocabulary; Stage 2 handlers accept strictly COMPLETE_SALES_ORDER, POST_SALES_RETURN, and POST_INVENTORY_ADJUSTMENT.",
      "enum": [
        "COMPLETE_SALES_ORDER",
        "POST_SALES_RETURN",
        "POST_INVENTORY_ADJUSTMENT",
        "RECEIVE_PURCHASE_ORDER",
        "CANCEL_REMAINING_PURCHASE_ORDER",
        "POST_VENDOR_RETURN"
      ]
    },
    "SyncProcessingStatus": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "APPLIED",
        "CONFLICT",
        "FAILED"
      ]
    },
    "SyncResultCode": {
      "type": "string",
      "enum": [
        "APPLIED",
        "CONFLICT",
        "FAILED"
      ]
    },
    "SyncDeliveryOutcome": {
      "type": "string",
      "enum": [
        "APPLIED",
        "ALREADY_APPLIED",
        "CONFLICT",
        "FAILED"
      ]
    },
    "AuditActorType": {
      "type": "string",
      "enum": [
        "USER",
        "SYSTEM",
        "AI_ASSISTED"
      ]
    },
    "SyncAuditFactDto": {
      "type": "object",
      "required": [
        "audit_log_id",
        "actor_type",
        "action",
        "entity_schema",
        "entity_name",
        "entity_id",
        "trace_id",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "audit_log_id": {
          "type": "string",
          "format": "uuid"
        },
        "actor_user_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "actor_employee_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "actor_type": {
          "$ref": "#/$defs/AuditActorType"
        },
        "action": {
          "type": "string"
        },
        "entity_schema": {
          "type": "string"
        },
        "entity_name": {
          "type": "string"
        },
        "entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_prompt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "before_data": {
          "type": [
            "string",
            "null"
          ]
        },
        "after_data": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
